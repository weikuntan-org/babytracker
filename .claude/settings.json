{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(git fetch *)",
      "Bash(eslint *)",
      "Bash(npx eslint *)",
      "Bash(npm run lint *)",
      "Bash(gh run watch *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/require-pre-pr-reviews.sh"
          }
        ]
      }
    ]
  }
}
